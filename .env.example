# Copy to .env and fill in to enable share-notification emails. Never commit .env.
# Gmail: use an App Password (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
SMTP_USER=you@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
# Public URL used in email links (defaults to the URL the request came in on)
# APP_URL=https://your-app.onrender.com
# Other SMTP providers: also set SMTP_HOST and SMTP_PORT
